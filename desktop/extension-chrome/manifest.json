{
  "manifest_version": 3,
  "name": "LibreAscent Blocker",
  "version": "1.2.0",
  "description": "Blocks Reels, Shorts, NSFW posts and adult keywords in Chrome.",
  "permissions": ["storage", "webNavigation", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "browsing", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["default-keywords.js", "matcher.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

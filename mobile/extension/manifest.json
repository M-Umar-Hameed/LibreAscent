{
  "manifest_version": 2,
  "name": "LibreAscent Mobile Blocker",
  "version": "1.0.0",
  "description": "Blocks Reels, Shorts, NSFW posts and adult keywords in Firefox for Android.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mobile-blocker@libreascent.app",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["default-keywords.js", "matcher.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["default-keywords.js", "matcher.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

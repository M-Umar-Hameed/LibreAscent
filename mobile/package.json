{
  "name": "libreascent",
  "main": "expo-router/entry",
  "version": "1.6.0",
  "author": "Touka_Debo",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-blocked-count-accumulator.js && node scripts/check-app-store-dedup-write.js && node scripts/check-cached-domains-paging.js && node scripts/check-mode-upgrade.js",
    "unused": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "babel-preset-expo": "~55.0.8",
    "date-fns": "^4.1.0",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.20",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.39",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-modules-core": "~55.0.25",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "freedom-accessibility-service": "./modules/freedom-accessibility-service",
    "freedom-device-admin": "./modules/freedom-device-admin",
    "freedom-foreground-service": "./modules/freedom-foreground-service",
    "freedom-overlay": "./modules/freedom-overlay",
    "freedom-vpn-service": "./modules/freedom-vpn-service",
    "nativewind": "^4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "reanimated-color-picker": "^4.2.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
